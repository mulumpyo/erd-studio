{
  "name": "erd-studio",
  "private": true,
  "description": "Collaborative crow’s-foot ERD editor with SQL import/export, teams, and real-time editing.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "dotenv -e .env -- pnpm --filter @erd-studio/api exec prisma db push",
    "db:generate": "dotenv -e .env -- pnpm --filter @erd-studio/api exec prisma generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @erd-studio/api exec prisma migrate dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
