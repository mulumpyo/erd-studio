# Copy to .env. In production JWT_SECRET must be a long random value (16+ chars).
DATABASE_URL=postgresql://erd:erd@localhost:5432/erdstudio
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=14d
API_PORT=3000
COLLAB_PORT=3030
# Must be the real site origin. Do not use * — the API sends credentials.
WEB_ORIGIN=http://localhost:5173
# Cookie flags. Same-origin reverse proxy is recommended so Collab can
# read the HttpOnly access cookie. Split API/collab hosts use /auth/ws-token.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# Local without SMTP: set this to show verify/invite links in the UI.
# Never enable in production.
# ALLOW_DEV_VERIFY_URL=true

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=
# MAIL_FROM="ERD Studio <you@example.com>"

# Local: leave VITE_API_URL empty (Vite proxies /api to Nest).
# Production: set the public API origin, and API_PREFIX=api
# API_PREFIX=api
# ENABLE_API_DOCS=true
# Public site origin for landing canonical / Open Graph. Example: https://erd.example.com
# VITE_SITE_URL=
VITE_COLLAB_URL=ws://localhost:3030

# First platform admin. Promotes that account if it already exists.
# INITIAL_ADMIN_EMAIL=you@example.com
