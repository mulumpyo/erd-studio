# Copy to .env. In production JWT_SECRET must be a long random value (16+ chars).
DATABASE_URL=postgresql://erd:erd@localhost:5432/erdstudio
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=14d
API_PORT=3000
COLLAB_PORT=3030
# Must be the real site origin. Do not use * — the API sends credentials.
WEB_ORIGIN=http://localhost:5173
# Cookie flags. Production defaults to Secure (TLS at nginx is fine).
# Local http://localhost stays non-Secure unless you set COOKIE_SECURE=true.
# Same-origin reverse proxy is recommended so Collab can read the HttpOnly
# access cookie. Split API/collab hosts use /auth/ws-token.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# Local without SMTP: set this to show verify/invite links in the UI.
# Never enable in production.
# ALLOW_DEV_VERIFY_URL=true

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=
# MAIL_FROM="ERD Studio <you@example.com>"

# Local: leave VITE_API_URL empty (Vite proxies /api to Nest).
# Production: set the public API origin, and API_PREFIX=api
# API_PREFIX=api
# ENABLE_API_DOCS=true
# Public site origin for landing canonical / Open Graph.
# VITE_SITE_URL=https://erd-studio.com
VITE_COLLAB_URL=ws://localhost:3030

# First platform admin. Promotes that account if it already exists.
# INITIAL_ADMIN_EMAIL=you@example.com

# AI 초안은 사용자 BYOK(ChatGPT / Gemini). 서버 키·엔드포인트 env는 필요 없어요.
# 기본은 준비 중(비활성). 열 때 API·웹 둘 다 켜세요.
# AI_FEATURES_ENABLED=true
# VITE_AI_FEATURES_ENABLED=true
